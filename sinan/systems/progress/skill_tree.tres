[resource]
script = ExtResource("1_tree")
upgrades = Array[ExtResource("2_up")]([SubResource("Resource_vitality"), SubResource("Resource_mending"), SubResource("Resource_resilience"), SubResource("Resource_thick_skin"), SubResource("Resource_unlock_rocket"), SubResource("Resource_firepower"), SubResource("Resource_trigger_finger"), SubResource("Resource_sharp_machete"), SubResource("Resource_unlock_brush"), SubResource("Resource_wide_strokes"), SubResource("Resource_quick_drying"), SubResource("Resource_steady_hand"), SubResource("Resource_lucky_coins"), SubResource("Resource_magnetism"), SubResource("Resource_bounty"), SubResource("Resource_short_rifts"), SubResource("Resource_thin_veil"), SubResource("Resource_sealed_sky"), SubResource("Resource_shadow_ward"), SubResource("Resource_rift_bounty")])
weapon_scenes = Array[PackedScene]([ExtResource("3_pistol"), ExtResource("4_rocket"), ExtResource("5_orb"), ExtResource("6_brush")])
weapon_names = PackedStringArray("Pistol", "Rocket Launcher", "Entropy Orb Staff", "Paint Brush Staff")
weapon_unlock_stats = Array[StringName]([&"", &"unlock_rocket", &"", &"unlock_brush"])
