[resource]
script = ExtResource("1_tree")
branches = Array[StringName]([&"Weapon", &"Coins", &"Enemies", &"Vitality"])
upgrades = Array[ExtResource("2_up")]([SubResource("U_firepower"), SubResource("U_wand_power"), SubResource("U_cast_speed"), SubResource("U_unlock_pistol"), SubResource("U_pistol_power"), SubResource("U_unlock_orb"), SubResource("U_orb_size"), SubResource("U_unlock_rocket"), SubResource("U_blast_radius"), SubResource("U_quick_fuse"), SubResource("U_rapid_fire"), SubResource("U_chain_lightning"), SubResource("U_twin_bolts"), SubResource("U_spark_cleanse"), SubResource("U_unlock_brush"), SubResource("U_brush_reach"), SubResource("U_deep_clean"), SubResource("U_brush_charge"), SubResource("U_crit_chance"), SubResource("U_crit_damage"), SubResource("U_machete"), SubResource("U_vitality"), SubResource("U_regeneration"), SubResource("U_lifesteal"), SubResource("U_second_wind"), SubResource("U_armor"), SubResource("U_thorns"), SubResource("U_jetpack"), SubResource("U_fuel_tank"), SubResource("U_quick_refuel"), SubResource("U_hover"), SubResource("U_thrust"), SubResource("U_afterburner"), SubResource("U_stabilizer"), SubResource("U_air_control"), SubResource("U_coin_value"), SubResource("U_magnetism"), SubResource("U_bounty"), SubResource("U_lucky_drop"), SubResource("U_restorer_pay"), SubResource("U_rift_bounty"), SubResource("U_open_rift"), SubResource("U_unlock_witch"), SubResource("U_witch_bounty"), SubResource("U_unlock_bird"), SubResource("U_bird_bounty"), SubResource("U_unlock_bats"), SubResource("U_bat_bounty"), SubResource("U_unlock_priest"), SubResource("U_priest_bounty"), SubResource("U_restless_forger"), SubResource("U_horde")])
weapon_scenes = Array[PackedScene]([ExtResource("3_wand"), ExtResource("4_pistol"), ExtResource("5_orb"), ExtResource("6_rocket"), ExtResource("7_brush")])
weapon_unlock_stats = Array[StringName]([&"", &"unlock_pistol", &"unlock_orb", &"unlock_rocket", &"unlock_brush"])
